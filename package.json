{
  "name": "capacity-planner-for-jira",
  "version": "1.0.0",
  "private": true,
  "description": "Capacity Planner for Jira - Forge Custom UI app for sprint capacity planning and reporting.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --config static/app/vite.config.ts",
    "build": "vite build --config static/app/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p static/app/tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "forge lint",
    "check": "npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && forge deploy -e development --non-interactive",
    "tunnel": "forge tunnel"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^7.2.1",
    "@forge/kvs": "^2.1.1",
    "@forge/resolver": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
